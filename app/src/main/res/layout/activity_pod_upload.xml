<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pod_upload.PodUploadActivity">
    <include
        android:id="@+id/top_bar"
        layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_20sdp"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_20sdp">

            <EditText
                android:id="@+id/etBarCode"
                android:layout_width="0dp"
                android:layout_height="45dp"
                app:layout_constraintHorizontal_weight="8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:paddingEnd="15dp"
                android:drawableEnd="@drawable/barcode"
                android:textIsSelectable="true"
                android:inputType="none"
                android:layout_margin="10dp"
                android:cursorVisible="false"
                android:paddingStart="10dp"
                android:textColor="@color/black"
                android:background="@drawable/edittext_background_rounded"
                android:hint="@string/bar_code"
                app:layout_constraintEnd_toStartOf="@+id/imgBarCode"/>

            <ImageView
                android:id="@+id/imgBarCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1"
                android:src="@drawable/camera"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintTop_toTopOf="@+id/etBarCode"
                app:layout_constraintStart_toEndOf="@+id/etBarCode"
                app:layout_constraintBottom_toBottomOf="@+id/etBarCode"
                app:layout_constraintEnd_toEndOf="parent"/>

            <AutoCompleteTextView
                android:id="@+id/type"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:gravity="start|center"
                android:inputType="none"
                android:hint="@string/select_option"
                android:layout_margin="10dp"
                android:paddingStart="10dp"
                android:elevation="6dp"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="visible"
                android:drawableEnd="@drawable/down_arrow"
                android:paddingEnd="20dp"
                android:translationZ="6dp"
                android:background="@drawable/edittext_background_rounded"
                app:layout_constraintTop_toBottomOf="@+id/etBarCode"/>


            <TextView
                android:id="@+id/tvCalender"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/edittext_background_rounded"
                android:gravity="start|center"
                android:paddingStart="10dp"
                android:textColor="@color/black"
                android:visibility="gone"
                android:textSize="14sp"
                android:hint="@string/select_date"
                android:elevation="6dp"
                android:translationZ="6dp"
                android:layout_margin="10dp"
                android:paddingEnd="15dp"
                app:layout_constraintTop_toBottomOf="@+id/type"
                tools:text="22/07/2022" />

            <AutoCompleteTextView
                android:id="@+id/reason"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center"
                android:inputType="none"
                android:textSize="@dimen/_12sdp"
                android:hint="@string/select_option"
                android:paddingStart="10dp"
                android:drawableEnd="@drawable/down_arrow"
                android:paddingEnd="20dp"
                android:elevation="6dp"
                android:translationZ="6dp"
                android:layout_margin="10dp"
                android:background="@drawable/edittext_background_rounded"
                app:layout_constraintTop_toBottomOf="@+id/tvCalender"/>



            <EditText
                android:id="@+id/cNoteNumber"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_margin="10dp"
                android:hint="@string/new_c_note_number"
                android:inputType="number"
                android:maxLength="10"
                android:textSize="@dimen/_12sdp"
                android:elevation="6dp"
                android:translationZ="4dp"
                android:paddingStart="10dp"
                android:background="@drawable/edittext_background_rounded"
                app:layout_constraintTop_toBottomOf="@+id/reason"/>


            <androidx.cardview.widget.CardView
                android:id="@+id/cameraCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1"
                android:layout_margin="@dimen/_10sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="@dimen/_5sdp"
                app:layout_constraintEnd_toStartOf="@+id/galleryCardView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cNoteNumber">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:src="@drawable/add_camera"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/cameraImg"
                        android:layout_width="60dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:visibility="invisible"
                        app:layout_constraintBottom_toTopOf="@+id/btnPhoto"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/btnPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:paddingBottom="10dp"
                        android:text="@string/click_to_take_photo"
                        android:textColor="@color/colorPrimary"
                        app:layout_constraintTop_toBottomOf="@+id/cameraImg" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/galleryCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1"
                android:layout_margin="@dimen/_10sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="@dimen/_5sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cameraCardView"
                app:layout_constraintTop_toBottomOf="@+id/cNoteNumber">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivGallery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:src="@drawable/gallery"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/galleryImg"
                        android:layout_width="60dp"
                        android:layout_height="80dp"
                        android:visibility="invisible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/btnGallery"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/btnGallery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:paddingBottom="10dp"
                        android:text="@string/choose_from_gallery"
                        android:textColor="@color/colorPrimary"
                        app:layout_constraintTop_toBottomOf="@+id/galleryImg" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvDocument"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Other Document File"
                android:layout_margin="10dp"
                android:textColor="@color/colorPrimary"
                app:layout_constraintTop_toBottomOf="@+id/cameraCardView"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/docOneCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1"
                android:layout_margin="@dimen/_10sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="@dimen/_5sdp"
                app:layout_constraintEnd_toStartOf="@+id/docTwoCardView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDocument">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/docOneGallery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:src="@drawable/gallery"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/docOneImg"
                        android:layout_width="60dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:visibility="invisible"
                        app:layout_constraintBottom_toTopOf="@+id/tvDocOne"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDocOne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:paddingBottom="10dp"
                        android:text="Choose document one"
                        android:textColor="@color/colorPrimary"
                        app:layout_constraintTop_toBottomOf="@+id/docOneImg" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/docTwoCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_weight="1"
                android:layout_margin="@dimen/_10sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="@dimen/_5sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/docOneCardView"
                app:layout_constraintTop_toBottomOf="@+id/tvDocument">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/docTwoGallery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:src="@drawable/gallery"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/docTwoImg"
                        android:layout_width="60dp"
                        android:layout_height="80dp"
                        android:visibility="invisible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvDocTwo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDocTwo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:paddingBottom="10dp"
                        android:text="Choose document two"
                        android:textColor="@color/colorPrimary"
                        app:layout_constraintTop_toBottomOf="@+id/docTwoImg" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>



            <!--<ImageView
                android:id="@+id/imgSelfi"
                android:layout_width="@dimen/_250sdp"
                android:layout_height="@dimen/_80sdp"
                android:src="@drawable/ic_image_placeholder"
                android:layout_marginTop="@dimen/_10sdp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivCamera"/>-->

            <Button
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:background="@drawable/button_background_rounded"
                android:text="@string/submit"
                android:layout_margin="10dp"
                android:textColor="@color/white"
                android:visibility="visible"
                android:enabled="true"
                app:layout_constraintTop_toBottomOf="@+id/docOneCardView"
                tools:visibility="visible" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupDelivered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="tvCalender"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupDeliveredDelay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="tvCalender,reason"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupUndelivered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="reason"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupRTO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="cNoteNumber"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="cameraCardView,galleryCardView"/>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupDocument"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="tvDocument,docOneCardView,docTwoCardView"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>